# Hyperlocal B-Roll Generator Environment Configuration
# Copy this file to .env and fill in your API keys

# Google Cloud Platform API Keys
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_STREETVIEW_API_KEY=your_google_streetview_api_key_here
GOOGLE_VEO_API_KEY=your_google_veo_api_key_here

# Nanobanana Pro API Key
# Get this from: https://nanobanana.pro/dashboard
NANOBANANA_API_KEY=your_nanobanana_api_key_here

# Application Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Generation Settings
DEFAULT_NUM_CLIPS=5
DEFAULT_SEARCH_RADIUS=3000
MAX_CONCURRENT_REQUESTS=3
CLIP_DURATION_SECONDS=5.0
